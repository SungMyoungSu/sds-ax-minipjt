# .env.example - 이 파일을 .env로 복사한 뒤 값을 채우세요.
#   copy .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. 실제 키를 이 파일에 쓰지 마세요.

# ===== LLM 접속 정보 =====
# 사용할 제공자 하나만 채웁니다. (bedrock | anthropic)
LLM_PROVIDER=bedrock

# --- (1) AWS Bedrock (reference/ 코드와 같은 방식) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 자격 증명(SSO 등)을 쓸 때만 채웁니다
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# 에이전트용 모델 ID
LLM_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# 입력 가드레일 2차 판별용 가벼운 모델(매 턴 Supervisor 앞에서 실행). 비우면 LLM_MODEL을 씁니다
GUARD_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# 평가(LLM 심사)용 모델. 버전을 비교하려면 고정해 둡니다
JUDGE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# 에이전트 호출의 Bedrock 프롬프트 캐싱(on | off, 기본 on). 가드레일·LLM 심사에는 쓰지 않습니다
PROMPT_CACHE=on
# 규정 검색에 임베딩을 쓸 경우에만 사용합니다
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# --- (2) Anthropic API 직접 호출 ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# 사내 프록시를 쓸 때만 채웁니다
# HTTPS_PROXY=

# ===== 공공데이터 (data.go.kr) =====
# '일반 인증키(Decoding)' 값을 넣습니다. 코드에서 URL 인코딩합니다.
# 두 API 모두 data.go.kr에서 각각 '활용신청'을 해야 같은 키로 호출할 수 있습니다.
DATA_GO_KR_KEY=
# 요청 타임아웃(초)
DATA_GO_KR_TIMEOUT=10

# (1) 행정안전부_봉사참여정보서비스_GW (1365, 데이터 15157582) - XML
#     기능: 봉사참여정보상세조회, 기간별/검색어/지역별/분야별 봉사참여정보목록조회
#     오퍼레이션 경로는 상세페이지의 '상세기능' 표에서 확인해 코드에서 Base URL 뒤에 붙입니다.
VOLUNTEER_1365_BASE_URL=https://apis.data.go.kr/1741000/volunteerPartcptnService
# 목록 조회 오퍼레이션(비우면 getVltrSearchWordList). 2026-11-05 실제 호출로 확인
VOLUNTEER_1365_LIST_OPERATION=getVltrSearchWordList

# 청소년 봉사 프로그램 API(15156325)는 쓰지 않습니다. 학생의 청소년 참여 가능 여부는 1365 응답(yngbgsPosblAt)으로 거릅니다.

# ===== 마감 알림 이메일 (SMTP) =====
# Gmail은 2단계 인증을 켠 뒤 앱 비밀번호(16자리)를 사용합니다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ===== 실행 환경 =====
APP_TIMEZONE=Asia/Seoul
# 로컬 데이터 폴더 (SQLite, 확인서 사본, trace 로그)
DATA_DIR=./data
LOG_LEVEL=INFO

# 기본 사내규정: 파일 없이 "회사 규정 등록해줘"라고 하면 이 파일을 등록합니다(비우면 아래 기본값).
# DEFAULT_POLICY_FILE=data/policies/사회공헌_봉사활동_규정.md
